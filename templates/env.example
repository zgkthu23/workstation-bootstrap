# =============================================================================
# Environment variable template
# Copy to .env and fill in values from your password manager.
# =============================================================================
# WARNING: Never commit .env or .env.local with real values.
# =============================================================================

# ── GitHub ──────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic or fine-grained)
# 1Password: "GitHub PAT"
# Bitwarden: "github-pat"
GITHUB_TOKEN=
GH_TOKEN=

# ── OpenAI / Anthropic / AI APIs ────────────────────────────────────────
# 1Password: "OpenAI API Key"
OPENAI_API_KEY=
# 1Password: "Anthropic API Key"
ANTHROPIC_API_KEY=
# 1Password: "Claude Code API Key"
CLAUDE_API_KEY=

# ── AWS ─────────────────────────────────────────────────────────────────
# 1Password: "AWS Access Key"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Database ────────────────────────────────────────────────────────────
# 1Password: "Local Postgres"
DATABASE_URL=

# ── Cloud Drives ────────────────────────────────────────────────────────
# Paths to cloud drive mount points (OS-specific)
# Windows: C:\Users\<user>\OneDrive
# Linux: /home/<user>/cloud
# macOS: /Users/<user>/Library/CloudStorage
CLOUD_ROOT=