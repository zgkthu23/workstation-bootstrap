# =============================================================================
# 环境变量模板
# 复制为 .env 并填入密码管理器中的实际值。
# =============================================================================
# 警告：切勿将含真实值的 .env 或 .env.local 提交到版本控制。
# =============================================================================

# ── GitHub ──────────────────────────────────────────────────────────────
# GitHub Personal Access Token（经典版或细粒度版）
# 1Password："GitHub PAT"
# Bitwarden："github-pat"
GITHUB_TOKEN=
GH_TOKEN=

# ── OpenAI / Anthropic / AI API ─────────────────────────────────────────
# 1Password："OpenAI API Key"
OPENAI_API_KEY=
# 1Password："Anthropic API Key"
ANTHROPIC_API_KEY=
# 1Password："Claude Code API Key"
CLAUDE_API_KEY=

# ── AWS ─────────────────────────────────────────────────────────────────
# 1Password："AWS Access Key"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── 数据库 ──────────────────────────────────────────────────────────────
# 1Password："Local Postgres"
DATABASE_URL=

# ── 云盘 ────────────────────────────────────────────────────────────────
# 云盘挂载点路径（按操作系统不同）
# Windows：C:\Users\<user>\OneDrive
# Linux：/home/<user>/cloud
# macOS：/Users/<user>/Library/CloudStorage
CLOUD_ROOT=