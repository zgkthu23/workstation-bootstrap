# =============================================================================
# Git 配置模板
# 复制为 ~/.gitconfig 并填入你的个人信息。
# =============================================================================

[user]
    name = YOUR_NAME
    email = YOUR_EMAIL

[core]
    editor = nvim
    autocrlf = input
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true
    default = simple

[pull]
    rebase = true

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --oneline --graph --all --decorate
    unstage = reset HEAD --
    last = log -1 HEAD

[credential]
    # 尽可能使用 SSH 密钥代替 HTTPS + credential helper
    # helper = /usr/local/bin/git-credential-manager

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff
    conflictstyle = diff3

# ── 平台特定覆盖 ───────────────────────────────────────────────────────
# Windows 上：
# [core]
#     autocrlf = true
# macOS 上：
# [credential]
#     helper = osxkeychain