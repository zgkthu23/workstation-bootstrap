# =============================================================================
# SSH 配置模板
# 复制为 ~/.ssh/config — 切勿提交真实的主机名/IP 地址。
# =============================================================================

# ── GitHub ──────────────────────────────────────────────────────────────
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# ── 你自己的主机模板 ───────────────────────────────────────────────────
# Host myserver
#     HostName 替换为实际主机名或IP
#     User 你的用户名
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22

# ── 全局默认值 ─────────────────────────────────────────────────────────
Host *
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    # UseKeychain yes    # macOS: 取消此行注释，注释掉 IgnoreUnknown
    ServerAliveInterval 60
    ServerAliveCountMax 3